            {
              "name": "api_key",
              "value": "2da0cea0af334ab7e1bfeacbf330826a"
            },
            {
              "name": "=query",
              "value": "={{ $json.message.text\n   .replace(/^[Tt]railer\\s*/i, '')                  // Xóa chữ Trailer\n   .replace(/\\b(phim|movie)\\b/gi, '')               // Xóa chữ Phim\n   .replace(/\\b(phần|tập|part)\\s*(\\d+)\\b/gi, ' $2') // Biến \"Phần 2\" thành \" 2\"\n   .replace(/\\s+1\\s*$/g, '')                        // Xóa số 1 ở cuối (Avatar 1 -> Avatar)\n   .replace(/\\s+/g, ' ')                            // Xóa dấu cách thừa\n   .trim()\n}}"
            },
